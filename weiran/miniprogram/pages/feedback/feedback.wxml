<view class="page">
  <view class="card">
    <view class="section-title">发起数据反馈</view>
    <view class="field">
      <view class="field-label">反馈类型</view>
      <picker mode="selector" range="{{typeOptions}}" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="picker-box">{{typeText}} ›</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">所属维度</view>
      <picker mode="selector" range="{{dimensionOptions}}" value="{{dimensionIndex}}" bindchange="onDimensionChange">
        <view class="picker-box">{{dimensionText}} ›</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">原因说明</view>
      <textarea class="textarea" maxlength="500" placeholder="请说明错误或缺失的具体情况（最多 500 字）…" value="{{reason}}" bindinput="onReasonInput" />
    </view>
    <button class="btn btn-primary" bindtap="onSubmit">提交反馈</button>
  </view>

  <view class="card">
    <view class="section-title">我的反馈</view>
    <view wx:if="{{feedbacks.length == 0}}" class="empty">暂无反馈</view>
    <view class="fb-item" wx:for="{{feedbacks}}" wx:key="id">
      <view class="between">
        <view class="strong">{{item.type}} · {{item.dimension}}</view>
        <view class="badge {{item.status == '已处理' ? 'badge-ok' : 'badge-warn'}}">{{item.status}}</view>
      </view>
      <view class="small">{{item.reason}}</view>
      <view class="small">{{item.createdAt}}</view>
    </view>
  </view>
</view>
