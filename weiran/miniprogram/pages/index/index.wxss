.topbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 20rpx;
}

.brand-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #4a3f30;
  letter-spacing: 4rpx;
}

.ip-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #8a5a2b;
  color: #fffdf8;
  border-radius: 999rpx;
  padding: 14rpx 26rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(138, 90, 43, 0.24);
}

.ip-entry-icon { margin-right: 8rpx; font-size: 28rpx; }

.hero-card { padding-top: 32rpx; }
.demo-picker { margin-bottom: 24rpx; font-size: 24rpx; }

.hello { font-size: 40rpx; font-weight: 600; color: #4a3f30; }

.academic-banner {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #f7e4c4, #f3d9ae);
  border: 1rpx solid #e8c98d;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
}

.banner-title { font-size: 30rpx; font-weight: 600; color: #8a5a1b; }

.banner-sub { font-size: 24rpx; color: #9a6410; margin-top: 4rpx; }

.banner-delta { font-size: 32rpx; font-weight: 700; }
.banner-delta.down { color: #3e6b3a; }
.banner-delta.up { color: #a33a2f; }
.banner-delta.flat { color: #8a8172; }

.banner-action { margin-top: 14rpx; font-size: 24rpx; color: #8a5a1b; }

.learn-card { border-left: 8rpx solid #c47b2f; }

.learn-title { font-size: 34rpx; font-weight: 700; color: #4a3f30; }

.learn-grid { display: flex; flex-direction: row; margin: 24rpx 0 16rpx; }

.learn-cell { flex: 1; text-align: center; }

.learn-num { font-size: 38rpx; font-weight: 700; color: #8a5a2b; }

.learn-tags { display: flex; flex-wrap: wrap; }

.kv { display: flex; flex-direction: row; margin-bottom: 8rpx; }

.kv-item { flex: 1; text-align: center; }

.kv-num { font-size: 32rpx; font-weight: 600; color: #4a3f30; }

.mb { margin-bottom: 12rpx; }

.edit-btn {
  color: #8a5a2b;
  border: 1rpx solid #d9c9a8;
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
  font-size: 24rpx;
}

.tag-row { margin-top: 8rpx; }
