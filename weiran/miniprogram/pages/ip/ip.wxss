.ip-page { text-align: center; }

.ip-avatar { font-size: 128rpx; margin-top: 40rpx; }

.ip-name { font-size: 48rpx; font-weight: 700; color: #4a3f30; margin-top: 8rpx; letter-spacing: 4rpx; }

.ip-desc { margin: 8rpx 0 32rpx; }

.theme-grid { display: flex; flex-direction: row; flex-wrap: wrap; justify-content: space-between; }

.theme-item { width: 48%; background: #f7f2e7; border-radius: 16rpx; padding: 28rpx 0; margin-bottom: 16rpx; }

.theme-icon { font-size: 56rpx; margin-bottom: 8rpx; }

.chat-placeholder { text-align: left; padding: 12rpx 0 20rpx; }

.bubble { display: inline-block; background: #f3ecdd; border-radius: 18rpx; padding: 18rpx 22rpx; max-width: 88%; color: #5a4e3b; }

.fake-input { margin-top: 16rpx; background: #f3f0e7; border-radius: 999rpx; padding: 18rpx 24rpx; color: #b0a68f; font-size: 24rpx; }
